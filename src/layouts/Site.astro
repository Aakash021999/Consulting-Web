---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';
import '../styles/redesign.css';
const { title } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://benzeneconsulting.in');
---
<!doctype html>
<html lang="en">
<head>

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18151776397"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'AW-18151776397');
</script>
<meta name="google-site-verification" content="6mu38_AI0Ve4n1qke486JGefQw6pZlnoWhqwsqjVerQ" />
<meta name="description" content="Benzene Consulting — Expert MSME consulting in India. Cost reduction, supply chain design, SOPs, ERP advisory and strategy consulting. Based in Delhi NCR, serving pan-India." />
<meta name="robots" content="index, follow" />
<meta property="og:title" content="Benzene Consulting | MSME Strategy, Supply Chain & Cost Consulting India" />
<meta property="og:description" content="Expert consulting for Indian MSMEs — cost reduction, supply chain design, SOPs, and ERP advisory. Based in Delhi NCR, serving pan-India." />
<meta property="og:url" content="https://benzeneconsulting.in" />
<meta property="og:type" content="website" />
<link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />
<link rel="apple-touch-icon" sizes="180x180" href="data:image/png;base64," />
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<title>{title} | Benzene Consulting</title>
<link rel="canonical" href={canonical} />
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<Navigation />
<main id="main-content"><slot /></main>
<Footer />
<script is:inline src="/site-interactions.js"></script>
<script>import '../scripts/forms';</script>
</body>
</html>
