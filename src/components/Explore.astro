---
const stories = [
  {
    id: 'capabilities', tab: 'Capabilities', title: 'Find the cost hiding in everyday operations',
    description: 'Review procurement, supplier performance, overheads and working capital to see where margins can improve.',
    image: '1565043589221-1a6fd9ae45c7', cta: ['Explore cost improvement', '/services/cost-improvement/'],
    links: [['Strategic planning', '/services/strategy/'], ['Supply chain optimisation', '/services/supply-chain/'], ['Operational excellence', '/services/operational-excellence/'], ['ERP advisory', '/erp-advisory.html']],
  },
  {
    id: 'results', tab: 'Client results', title: 'From 18 days to 9',
    description: 'See how the manufacturing engagement changed lead time, procurement costs and supplier counts.',
    image: '1586528116311-ad8dd3c8310d', cta: ['Compare engagement results', '/publications/#results-explorer'],
    links: [['Manufacturing cost reduction', '/publications/manufacturing-cost-reduction/'], ['Supply chain build', '/publications/supply-chain-build/'], ['Logistics turnaround', '/publications/logistics-turnaround/'], ['Check your growth readiness', '/#diagnostic']],
  },
  {
    id: 'insights', tab: 'Research and insights', title: 'Build a supply chain from scratch',
    description: 'Explore the five-phase blueprint, from mapping the flow of goods to setting up operating controls.',
    image: '1494412574643-ff11b0a5c1c3', cta: ['Read the supply chain blueprint', '/insights/supply-chain-blueprint/'],
    links: [['Finding procurement overpayments', '/insights/procurement-overpayments/'], ['Writing SOPs that get used', '/insights/writing-sops/'], ['Browse all insights', '/insights/']],
  },
];
---
<section class="story-explorer" id="explore" aria-labelledby="explore-title">
  <h2 class="section-title" id="explore-title">Explore our work</h2>
  <fieldset class="story-selector">
    <legend>Choose a topic</legend>
    <div class="story-options">
      {stories.map(({id, tab}, index) => (
        <label><input type="radio" name="featured-story" value={id} checked={index === 0} /> <span>{tab}</span></label>
      ))}
    </div>
    {stories.map(({id, title, description, image, cta, links}) => (
      <article class="story-panel" data-story={id}>
        <img src={`https://images.unsplash.com/photo-${image}?w=1100&q=80&fit=crop`} alt="" width="1100" height="700" loading="lazy" decoding="async" />
        <div class="story-copy">
          <h3>{title}</h3>
          <p>{description}</p>
          <a class="story-primary" href={cta[1]}>{cta[0]} <span aria-hidden="true">↗</span></a>
        </div>
        <ul class="story-links">
          {links.map(([label,href]) => <li><a href={href}>{label}<span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </article>
    ))}
  </fieldset>
</section>
<style>
  .story-explorer { padding-inline: 5vw; background: #eef4ef; }
  .story-selector { min-inline-size: 0; padding: 0; border: 0; }
  .story-selector legend { margin-bottom: 10px; color: #31574a; }
  .story-options { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .story-options label { display: flex; align-items: center; gap: 8px; cursor: pointer; padding: 10px 14px; border: 1px solid #8ca69a; background: #fff; color: #092b25; }
  .story-options input { accent-color: #076648; }
  .story-options label:has(:checked) { background: #092b25; color: #fff; }
  .story-panel { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,1fr); background: #092b25; color: #fff; }
  .story-panel img { width: 100%; height: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .story-copy { display: grid; align-content: center; gap: 16px; padding: clamp(22px, 5vw, 64px); }
  .story-copy h3 { font: 600 clamp(2rem, 4vw, 4rem)/1.02 'Cormorant Garamond', serif; }
  .story-copy p { max-width: 48ch; }
  .story-primary { color: #a5e8bd; text-underline-offset: 5px; }
  .story-links { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,220px),1fr)); list-style: none; margin: 0; padding: 0; background: #fff; }
  .story-links a { height: 100%; display: flex; justify-content: space-between; gap: 10px; padding: 17px; border: 1px solid #d4dfd8; color: #092b25; text-decoration: none; }
  .story-links a:hover, .story-links a:focus-visible { background: #ddf0e4; text-decoration: underline; }
  @supports selector(:has(*)) {
    .story-panel { display: none; }
    .story-selector:has([value="capabilities"]:checked) [data-story="capabilities"],
    .story-selector:has([value="results"]:checked) [data-story="results"],
    .story-selector:has([value="insights"]:checked) [data-story="insights"] { display: grid; }
  }
  @media (max-width: 700px) { .story-panel { grid-template-columns: 1fr; } }
</style>
