---
const { standalone = false } = Astro.props;
const Heading = standalone ? 'h1' : 'h2';
const additionalAreas = [
  { key: 'cash', title: 'Cash and working capital', detail: 'Cash forecasts, receivables follow-up and inventory tied up in stock.', low: 'Reactive', high: 'Planned' },
  { key: 'customers', title: 'Customer retention', detail: 'Repeat purchase, customer feedback and ownership of service issues.', low: 'Untracked', high: 'Managed' },
  { key: 'people', title: 'Team and delegation', detail: 'Clear roles, decision rights and coverage when key people are away.', low: 'Founder-led', high: 'Delegated' },
  { key: 'strategy', title: 'Growth planning', detail: 'Defined priorities, accountable owners and regular progress reviews.', low: 'Informal', high: 'Reviewed' },
];
---
<section id="diagnostic">
  <div class="section-label">Interactive Diagnostic</div>
  <Heading class="section-title">Find Your <em>Growth Readiness</em> Score</Heading>
  <p class="section-sub">Move the sliders to model your current operating maturity. Your score is the average of eight equally weighted ratings, scaled to 100. Start with the three lowest-scoring areas.</p>

  <div class="diagnostic-shell">
    <div class="diagnostic-panel fade-in">
      <p class="diagnostic-intro">Rate each area from 1 to 10. A higher score means the capability is documented, measured, and consistently followed by your team.</p>
      <div class="diagnostic-controls">
        <div class="diagnostic-control">
          <div class="diagnostic-control-top">
            <label for="diag-process">Process documentation<small>SOPs, handovers, approval matrices, and standard workflows.</small></label>
            <div class="diagnostic-value" id="diag-process-val">5</div>
          </div>
          <input id="diag-process" type="range" min="1" max="10" value="5" oninput="updateDiagnostic()">
          <div class="diagnostic-scale"><span>Ad hoc</span><span>Systemised</span></div>
        </div>

        <div class="diagnostic-control">
          <div class="diagnostic-control-top">
            <label for="diag-cost">Cost visibility<small>Spend baselines, vendor contracts, budget ownership, and margin tracking.</small></label>
            <div class="diagnostic-value" id="diag-cost-val">6</div>
          </div>
          <input id="diag-cost" type="range" min="1" max="10" value="6" oninput="updateDiagnostic()">
          <div class="diagnostic-scale"><span>Opaque</span><span>Measured</span></div>
        </div>

        <div class="diagnostic-control">
          <div class="diagnostic-control-top">
            <label for="diag-supply">Supply-chain resilience<small>Supplier risk, inventory discipline, logistics planning, and delivery reliability.</small></label>
            <div class="diagnostic-value" id="diag-supply-val">5</div>
          </div>
          <input id="diag-supply" type="range" min="1" max="10" value="5" oninput="updateDiagnostic()">
          <div class="diagnostic-scale"><span>Fragile</span><span>Resilient</span></div>
        </div>

        <div class="diagnostic-control">
          <div class="diagnostic-control-top">
            <label for="diag-tech">Technology fit<small>ERP readiness, dashboard adoption, clean master data, and workflow automation.</small></label>
            <div class="diagnostic-value" id="diag-tech-val">4</div>
          </div>
          <input id="diag-tech" type="range" min="1" max="10" value="4" oninput="updateDiagnostic()">
          <div class="diagnostic-scale"><span>Manual</span><span>Enabled</span></div>
        </div>
        {additionalAreas.map(({key, title, detail, low, high}) => (
          <div class="diagnostic-control">
            <div class="diagnostic-control-top">
              <label for={`diag-${key}`}>{title}<small>{detail}</small></label>
              <output class="diagnostic-value" id={`diag-${key}-val`} for={`diag-${key}`}>5</output>
            </div>
            <input id={`diag-${key}`} type="range" min="1" max="10" value="5" oninput="updateDiagnostic()" />
            <div class="diagnostic-scale"><span>{low}</span><span>{high}</span></div>
          </div>
        ))}
      </div>
    </div>

    <div class="diagnostic-result fade-in fade-in-delay-1">
      <div class="score-ring" id="scoreRing" style="--score:50%">
        <div class="score-inner">
          <div class="score-num" id="diag-score">50</div>
          <div class="score-label">out of 100</div>
        </div>
      </div>
      <div>
        <div class="result-tag" id="diag-stage">Build the foundation</div>
        <h3 class="result-title" id="diag-title">Your systems need structure before scale.</h3>
        <p class="result-copy" id="diag-copy">The business has enough traction to grow, but inconsistent processes and manual decision-making may create avoidable cost, delays, and founder dependency.</p>
        <ul class="priority-list" id="diag-priorities"></ul>
        <div class="diagnostic-actions">
          <a class="diag-primary" href="/#contact">Discuss My Score →</a>
          <a class="diag-secondary" href="/#services">Match to Services</a>
          {standalone
            ? <a class="diag-secondary" href="https://wa.me/?text=Try%20the%20Benzene%20Growth%20Readiness%20Score%3A%20https%3A%2F%2Fbenzeneconsulting.in%2Fgrowth-readiness%2F" target="_blank" rel="noopener">Share tool on WhatsApp</a>
            : <a class="diag-secondary" href="/growth-readiness/">Open shareable assessment</a>}

        </div>
      </div>
      <div class="diagnostic-mini-cards">
        <a class="diagnostic-mini-card" href="/services/operational-excellence/"><strong>SOP Sprint</strong><span>Document critical workflows and train teams to reduce owner dependency.</span></a>
        <a class="diagnostic-mini-card" href="/services/cost-improvement/"><strong>Margin Scan</strong><span>Identify procurement, overhead, working-capital, and logistics leakage.</span></a>
        <a class="diagnostic-mini-card" href="/#erp"><strong>ERP Fit Check</strong><span>Clarify technology requirements before vendor demos or implementation spend.</span></a>
      </div>
    </div>
  </div>
</section>
